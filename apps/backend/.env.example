# Local defaults need no database service or AI key.
PORT=4111
HOST=0.0.0.0
PGLITE_DATA_DIR=./.data/pglite

# Production requires NODE_ENV=production and a PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@host:5432/tontu?sslmode=verify-full

# Enable the starter agent by choosing provider/model and setting its provider key.
# MASTRA_MODEL=openai/gpt-5-mini
# OPENAI_API_KEY=
